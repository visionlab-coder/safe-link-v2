{
  "name": "@sq-link/mobile",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build",
    "cap:add:android": "cap add android",
    "cap:add:ios": "cap add ios",
    "cap:sync:android": "cap sync android",
    "cap:sync:ios": "cap sync ios",
    "cap:open:ios": "cap open ios",
    "android:check:release": "cd android && ./gradlew safeLinkReleaseReadiness",
    "ios:check:release": "node scripts/check-ios-release.mjs",
    "store:check": "node scripts/check-store-readiness.mjs",
    "android:assemble:debug": "cd android && ./gradlew assembleDebug",
    "android:bundle:release": "cd android && ./gradlew bundleRelease",
    "android:assemble:release": "cd android && ./gradlew bundleRelease"
  },
  "dependencies": {
    "@capacitor/core": "^8.0.0",
    "@capacitor/local-notifications": "^8.2.0",
    "@capacitor/preferences": "^8.0.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@capacitor/android": "^8.0.0",
    "@capacitor/cli": "^8.0.0",
    "@capacitor/ios": "^8.4.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "typescript": "^5.9.0",
    "vite": "^7.2.0"
  },
  "overrides": {
    "esbuild": "^0.28.1"
  }
}
