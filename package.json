{
  "name": "safe-link-v2",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:cloudflare": "opennextjs-cloudflare build && node scripts/strip-oversized-cf-assets.mjs",
    "deploy": "opennextjs-cloudflare build && node scripts/strip-oversized-cf-assets.mjs && wrangler deploy",
    "preview": "opennextjs-cloudflare build && wrangler dev",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src next.config.ts open-next.config.ts",
    "test:release-info": "node --no-warnings --experimental-strip-types scripts/release-info-contract.mjs",
    "check:secrets": "node scripts/check-repository-secrets.mjs",
    "check:web": "npm run typecheck && npm run lint && npm run test:release-info && npm run check:secrets && npm run build",
    "flitto:rtt:smoke": "node scripts/flitto-rtt-smoke.mjs",
    "m2m100:start": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/start-m2m100-onnx-local.ps1"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.2.0",
    "@supabase/ssr": "^0.8.0",
    "@supabase/supabase-js": "^2.97.0",
    "@types/react-signature-canvas": "^1.0.7",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.0",
    "dotenv": "^17.3.1",
    "fft.js": "^4.0.4",
    "framer-motion": "^12.34.3",
    "jose": "^6.2.3",
    "lightningcss": "^1.32.0",
    "lucide-react": "^0.575.0",
    "mammoth": "^1.12.0",
    "next": "^15.5.13",
    "onnxruntime-web": "^1.27.0",
    "pusher": "^5.3.3",
    "pusher-js": "^8.5.0",
    "qrcode.react": "^4.2.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-signature-canvas": "^1.1.0-alpha.2",
    "tiny-pinyin": "^1.3.2",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.1.7",
    "pg": "^8.20.0",
    "playwright-core": "^1.61.0",
    "tailwindcss": "^4",
    "typescript": "5.8.2",
    "wrangler": "^4.105.0"
  }
}
